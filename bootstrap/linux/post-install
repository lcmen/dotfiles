#!/usr/bin/env bash

set -euo pipefail

# Apply Linux setup that depends on installed system packages.
. /etc/os-release

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
mise_local_config="$repository_root/mise/config.local.toml"

# Keep Linux-only global tools in the ignored machine-local configuration. Using
# `mise use` both merges the declaration without replacing other local tools and
# installs Herdr.
mise use --path "$mise_local_config" herdr@latest

# Symlink batcat to bat on Ubuntu
if [[ "${ID:-}" == "ubuntu" ]]; then
    sudo locale-gen en_US.UTF-8
    sudo update-locale LANG=en_US.UTF-8

    if command -v batcat >/dev/null 2>&1; then
        sudo ln -sfn "$(command -v batcat)" /usr/local/bin/bat
    fi
fi

# Add user to docker group
if getent group docker >/dev/null 2>&1 && ! id -nG "$USER" | tr ' ' '\n' | grep -qx docker; then
    sudo usermod -aG docker "$USER"
    echo "Docker group membership changed; start a new login session before using Docker."
fi
