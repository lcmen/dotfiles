#!/usr/bin/env bash

set -Eeuo pipefail

NULL_SHA=0000000000000000000000000000000000000000
WORKTREE_PATH="$PWD"
# The first entry of `git worktree list` is always the main worktree.
REPO_ROOT="$(git worktree list --porcelain | sed -n '1s/^worktree //p')"
SYMLINK_DIRS=(deps node_modules vendor/bundle)

copy_included_files() {
  local entry

  while IFS= read -r entry || [[ -n "$entry" ]]; do
    entry="$(printf '%s' "$entry" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"

    [[ -z "$entry" ]] && continue
    # Already there when the entry is tracked rather than ignored.
    [[ -e "$WORKTREE_PATH/$entry" ]] && continue

    if [[ -e "$REPO_ROOT/$entry" ]]; then
      mkdir -p "$(dirname "$WORKTREE_PATH/$entry")"
      if [[ -d "$REPO_ROOT/$entry" ]]; then
        if is_symlink_dir "$entry"; then
          ln -s "$REPO_ROOT/$entry" "$WORKTREE_PATH/$entry"
        else
          cp -R "$REPO_ROOT/$entry/." "$WORKTREE_PATH/$entry"
        fi
      else
        cp -R "$REPO_ROOT/$entry" "$WORKTREE_PATH/$entry"
      fi
    else
      warn "included entry '$entry' does not exist"
    fi
  done < <(included_file_entries)
}

# Worktree-only layouts keep the main entry bare, so it has no files to copy from.
has_working_copy() {
  [[ "$(git -C "$REPO_ROOT" rev-parse --is-bare-repository)" == "false" ]]
}

included_file_entries() {
  local manifest="$REPO_ROOT/.worktreeinclude"

  [[ -f "$manifest" ]] || return 0

  cat "$manifest"
}

is_linked_worktree() {
  local git_dir="$(git rev-parse --absolute-git-dir)"
  local common_dir="$(cd "$(git rev-parse --git-common-dir)" && pwd)"

  [[ "$git_dir" != "$common_dir" ]]
}

is_new_checkout() {
  local prev_head="${1:-}"
  local new_head="${2:-}"
  local checkout_flags="${3:-}"

  [[ "$prev_head" == "$NULL_SHA" && "$checkout_flags" == "1" ]]
}

is_symlink_dir() {
  local candidate="$1"
  local dir

  for dir in "${SYMLINK_DIRS[@]}"; do
    [[ "$candidate" == "$dir" ]] && return 0
  done

  return 1
}

setup_mise() {
  [[ -f "$WORKTREE_PATH/mise.toml" ]] || return 0
  command -v mise >/dev/null 2>&1 || {
    warn "mise.toml found but mise is not installed; skipping"
    return 0
  }

  mise trust "$WORKTREE_PATH/mise.toml" >&2
  (cd "$WORKTREE_PATH" && mise install) >&2
}

warn() {
  echo "worktree-setup (warning): $*" >&2
}

trap 'warn "setup did not complete"; exit 0' ERR

is_new_checkout "$@" || exit 0
is_linked_worktree || exit 0
has_working_copy || exit 0

copy_included_files
setup_mise

exit 0
