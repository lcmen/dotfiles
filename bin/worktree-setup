#!/usr/bin/env bash

# It calls mise trust, and install all tools.
# Copy all files listed in .worktreeinclude from the main worktree.
# Dependency directories such as deps, node_modules and vendor/bundle are symlinked to the main worktree.

set -Eeuo pipefail

NULL_SHA=0000000000000000000000000000000000000000
WORKTREE_PATH="$PWD"
REPO_ROOT="$(git worktree list --porcelain | sed -n '1s/^worktree //p')"
SYMLINK_DIRS=(deps node_modules vendor/bundle)
ENV_SECTION_PATTERN='^[[:space:]]*\[env\][[:space:]]*(#.*)?$'
PREVIOUS_HEAD="${1:-}"
NEW_HEAD="${2:-}"
BRANCH_CHECKOUT="${3:-}"

copy_included_files() {
  local entry

  while IFS= read -r entry || [[ -n "$entry" ]]; do
    entry="$(printf '%s' "$entry" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"

    [[ -z "$entry" ]] && continue

    if [[ -e "$REPO_ROOT/$entry" ]]; then
      mkdir -p "$(dirname "$WORKTREE_PATH/$entry")"
      if is_symlink_dir "$entry"; then
        ln -sfn "$REPO_ROOT/$entry" "$WORKTREE_PATH/$entry"
      elif [[ -d "$REPO_ROOT/$entry" ]]; then
        mkdir -p "$WORKTREE_PATH/$entry"
        cp -R "$REPO_ROOT/$entry/." "$WORKTREE_PATH/$entry"
      else
        cp -R "$REPO_ROOT/$entry" "$WORKTREE_PATH/$entry"
      fi
    else
      warn "included entry '$entry' does not exist"
    fi
  done < <(included_file_entries)
}

included_file_entries() {
  local manifest="$REPO_ROOT/.worktreeinclude"

  [[ -f "$manifest" ]] || return 0

  cat "$manifest"
}

is_checkout() {
  local previous_head="$1"
  local new_head="$2"
  local branch_checkout="$3"

  [[ "$previous_head" == "$NULL_SHA" && "$new_head" != "$NULL_SHA" && "$branch_checkout" == "1" ]]
}

is_symlink_dir() {
  local candidate="$1"
  local dir

  for dir in "${SYMLINK_DIRS[@]}"; do
    [[ "$candidate" == "$dir" ]] && return 0
  done

  return 1
}

is_worktree() {
  local worktree_path="$1"
  local git_dir="$(git -C "$worktree_path" rev-parse --absolute-git-dir)"
  local common_dir="$(git -C "$worktree_path" rev-parse --path-format=absolute --git-common-dir)"

  # Git worktrees keep their git dir under the main worktree's .git/worktrees
  [[ "$git_dir" != "$common_dir" ]]
}

non_bare_repo() {
  local repo_root="$1"

  [[ "$(git -C "$repo_root" rev-parse --is-bare-repository)" == "false" ]]
}

next_worktree_id() {
  local path id candidate
  local -a used=()

  while IFS= read -r path; do
    id="$(git -C "$path" config --worktree --get worktreeSetup.id 2>/dev/null || true)"
    if [[ "$id" =~ ^[0-9]+$ ]] && (( id >= 1 && id <= 16 )); then
      used[id]=1
    fi
  done < <(git worktree list --porcelain | sed -n 's/^worktree //p')

  for (( candidate = 1; candidate <= 16; candidate++ )); do
    if [[ -z "${used[$candidate]:-}" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  return 1
}

prepend_to_env_section() {
  local source="$1"
  local target="$2"
  local id="$3"
  local line
  local inserted=false

  while IFS= read -r line || [[ -n "$line" ]]; do
    printf '%s\n' "$line"

    if [[ "$inserted" == false && "$line" =~ $ENV_SECTION_PATTERN ]]; then
      printf 'WORKTREE_ID = "%s"\n' "$id"
      inserted=true
    fi
  done < "$source" > "$target"
}

write_mise_local() {
  local id="$1"
  local source="$REPO_ROOT/mise.local.toml"
  local target="$WORKTREE_PATH/mise.local.toml"

  if [[ -f "$source" ]] && grep -Eq "$ENV_SECTION_PATTERN" "$source"; then
    prepend_to_env_section "$source" "$target" "$id"
  else
    printf '[env]\nWORKTREE_ID = "%s"\n' "$id" > "$target"
    if [[ -f "$source" ]]; then cat "$source" >> "$target"; fi
  fi
}

setup_mise() {
  local id

  [[ -f "$REPO_ROOT/mise.toml" ]] || return 0

  git -C "$REPO_ROOT" config extensions.worktreeConfig true

  if id="$(next_worktree_id)"; then
    git config --worktree worktreeSetup.id "$id"
    write_mise_local "$id"
  else
    warn "all worktree IDs (1-16) are in use; skipping ID assignment"
  fi

  command -v mise >/dev/null 2>&1 || {
    warn "mise.toml found but mise is not installed; skipping"
    return 0
  }

  mise trust "$WORKTREE_PATH/mise.toml" >&2
  (cd "$WORKTREE_PATH" && mise install) >&2
}

warn() {
  echo "worktree-setup (warning): $*" >&2
}

trap 'warn "setup did not complete"; exit 0' ERR

is_checkout "$PREVIOUS_HEAD" "$NEW_HEAD" "$BRANCH_CHECKOUT" || exit 0
is_worktree "$WORKTREE_PATH" || exit 0
non_bare_repo "$REPO_ROOT" || exit 0

copy_included_files
setup_mise

exit 0
