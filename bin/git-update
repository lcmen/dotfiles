#!/usr/bin/env bash

# Fetch updates and delete local branches whose upstream no longer exists.

set -euo pipefail

git fetch --prune
git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads |
  awk '$NF == "[gone]" {print $1}' |
  while IFS= read -r branch; do
    git branch -D -- "$branch"
  done
