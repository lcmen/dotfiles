# Legacy local package selections are no longer consumed, but keep existing
# machine-local files out of version control.
.brew-skip

# Ignore fish variables
fish/fish_variables
fish/conf.d/secrets.local.fish

# Ignore machine-local Mise tools
mise/config.local.toml

# Ignore local configs
configs/mise.local.toml

# Ignore Postgres history and passwords
psql/history
psql/pgpass

# Ignore OrbStack
fish/completions/docker.fish
fish/completions/kubectl.fish
fish/completions/orbctl.fish

